{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:impacts:schema:vorgang:v0",
  "title": "Vorgang",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "hauptprozess_ref": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["angelegt", "in_pruefung", "wartend", "abgeschlossen"]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "receipt_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "required": [
    "id",
    "hauptprozess_ref",
    "status",
    "run_id",
    "receipt_refs"
  ]
}
