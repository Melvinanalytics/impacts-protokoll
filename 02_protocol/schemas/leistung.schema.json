{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:impacts:schema:leistung:v1",
  "title": "Leistung",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ergebnis": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "kennzahl": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "abnahme": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
    },
    "erreicht": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^end:[a-z0-9]+(?:-[a-z0-9]+)*$"}
    }
  },
  "required": ["ergebnis", "kennzahl", "abnahme"]
}
