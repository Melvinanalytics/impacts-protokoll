{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:impacts:schema:hauptprozess:v0",
  "title": "Hauptprozess",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "leistung_ref": {
      "type": "string",
      "minLength": 1
    },
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "required": [
    "id",
    "leistung_ref",
    "entry",
    "nodes"
  ],
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "task",
            "gateway",
            "wait",
            "handoff",
            "end"
          ]
        },
        "next": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "condition": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "condition",
              "target"
            ]
          }
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "artifact_ref": {
          "type": "string",
          "minLength": 1
        },
        "consumer_ref": {
          "type": "string",
          "minLength": 1
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "continuation_condition": {
          "type": "string",
          "minLength": 1
        },
        "exit_condition": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "type",
        "next"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "gateway"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "routes"
            ]
          },
          "else": {
            "not": {
              "required": [
                "routes"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "wait"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "next": {
                "minItems": 1,
                "maxItems": 1
              }
            },
            "required": [
              "trigger",
              "owner"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "handoff"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "artifact_ref",
              "consumer_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "end"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "next": {
                "maxItems": 0
              }
            },
            "required": [
              "event"
            ]
          }
        }
      ]
    }
  }
}
