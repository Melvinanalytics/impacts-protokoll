{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:impacts:schema:wiedervorlage:v0",
  "title": "Wiedervorlage",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "vorgang_ref": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "trigger": {"type": "string", "minLength": 1},
    "continuation": {"type": "string", "minLength": 1},
    "status": {"enum": ["wartend", "bereit", "fortgesetzt", "geschlossen"]},
    "receipt_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "required": [
    "id", "vorgang_ref", "run_id", "owner", "trigger", "continuation", "status", "receipt_refs"
  ]
}
