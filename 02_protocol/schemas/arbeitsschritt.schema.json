{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:impacts:schema:arbeitsschritt:v1",
  "title": "Arbeitsschritt",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {"const": "arbeitsschritt"},
    "id": {"type": "string", "pattern": "^arbeitsschritt:[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "eingaben": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!/)(?![^/]*:)[^\\x00-\\x1f]+(?![\\s\\S])"}
    },
    "ausgaben": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)output/[^\\x00-\\x1f]+$"}
    },
    "pruefung": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "gate": {"const": "human"},
    "routen": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
      "additionalProperties": {"type": "string", "pattern": "^(?:arbeitsschritt|end):[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "customer_touchpoint": {"enum": ["standard", "sacred"]}
  },
  "required": ["type", "id", "eingaben", "ausgaben", "pruefung", "routen"],
  "$defs": {
    "dateireferenz": {
      "oneOf": [
        {"$ref": "#/$defs/leseausgabereferenz"},
        {"$ref": "#/$defs/quellreferenz"},
        {"$ref": "#/$defs/ablageverweis"}
      ]
    },
    "leseausgabereferenz": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pfad": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)[^\\x00-\\x1f]+(?![\\s\\S])"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "eingabe": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!/)(?![^/]*:)[^\\x00-\\x1f]+(?![\\s\\S])"}
      },
      "allOf": [
        {"$ref": "#/$defs/dateipflicht"}
      ]
    },
    "ausgabereferenz": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pfad": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)[^\\x00-\\x1f]+(?![\\s\\S])"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {"$ref": "#/$defs/dateipflicht"}
      ]
    },
    "quellreferenz": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eingabe": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!/)(?![^/]*:)[^\\x00-\\x1f]+(?![\\s\\S])"},
        "pfad": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)[^\\x00-\\x1f]+(?![\\s\\S])"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "revision": {"type": "string", "pattern": "^git-commit:(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])"}
      },
      "required": ["pfad", "revision", "sha256"]
    },
    "ablageverweis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eingabe": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!/)(?![^/]*:)[^\\x00-\\x1f]+(?![\\s\\S])"},
        "ablage": {"type": "string", "pattern": ".*\\S.*"},
        "schluessel": {"type": "string", "pattern": ".*\\S.*"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["ablage", "schluessel", "sha256"]
    },
    "dateipflicht": {"required": ["pfad", "sha256"]},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"}
  }
}
