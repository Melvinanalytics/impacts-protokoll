{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:impacts:schema:arbeitsschritt:v1",
  "title": "Arbeitsschritt",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {"const": "arbeitsschritt"},
    "id": {"type": "string", "pattern": "^arbeitsschritt:[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "eingaben": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)input/[^\\x00-\\x1f]+$"}
    },
    "ausgaben": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)output/[^\\x00-\\x1f]+$"}
    },
    "pruefung": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "gate": {"const": "human"},
    "routen": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
      "additionalProperties": {"type": "string", "pattern": "^(?:arbeitsschritt|end):[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "customer_touchpoint": {"enum": ["standard", "sacred"]}
  },
  "required": ["type", "id", "eingaben", "ausgaben", "pruefung", "routen"]
}
