{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:impacts:schema:paketaktivierungen:v0",
  "title": "Paketaktivierungen",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "customer_id": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "packages": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "activation": {"enum": ["generated", "active", "inactive"]},
          "evidence_status": {"enum": ["reported", "hypothesis", "open"]}
        },
        "required": ["id", "version", "activation", "evidence_status"]
      }
    }
  },
  "required": ["customer_id", "packages"]
}
